# Copy this file to .env.local and fill in the credentials.

# --- Company SMTP (default) --------------------------------------------------
# gkllc.mn mail is hosted by mail.mn. Use smtp.mail.mn, not smtp.gkllc.mn:
# both resolve to the same server, but the certificate only covers
# *.mail.mn, so the gkllc.mn name fails TLS hostname verification.
# Use port 587 (STARTTLS), or 465 with SMTP_SECURE=true if 587 is blocked.
SMTP_HOST=smtp.mail.mn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=it@gkllc.mn
SMTP_PASS=P@33w0rd

# Sender shown to recipients. Defaults to SMTP_USER.
# Most providers require this to match the authenticated mailbox.
# MAIL_FROM=Аяллын маягт <no-reply@gkllc.mn>

# Recipients. Defaults to it@gkllc.mn,admin@gkllc.mn,share@gkllc.mn
# MAIL_TO=it@gkllc.mn,admin@gkllc.mn,share@gkllc.mn

# --- Resend (fallback) -------------------------------------------------------
# Used only when SMTP_HOST is empty. Requires the gkllc.mn domain to be
# verified in Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
